# ============================================================================
# YuleTech AutoSAR BSW Platform - .gitignore
# 忽略编译产物、IDE配置、临时文件等
# ============================================================================

# Build artifacts (编译产物)
build/
*.o
*.obj
*.exe
*.elf
*.bin
*.hex
*.map
*.lst
*.sym
*.out
*.a
*.lib
*.so
*.dll

# CMake
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# IDE Configuration (IDE 配置)
.vscode/
.idea/
*.swp
*.swo
*~
.project
.cproject
.settings/
*.sublime-project
*.sublime-workspace

# Generated code (代码生成产物)
generated/

# Reports (分析报告 - 大文件)
reports/*.json
reports/*.xml
coverage/
*.gcov
*.gcda
*.gcno

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/

# Node.js (docs-site & website)
docs-site/node_modules/
docs-site/dist/
website/node_modules/

# Arms Cache
arms_cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files (操作系统临时文件)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files (临时文件)
*.tmp
*.temp
*.log
*.bak
*.swp

# Test artifacts
test_runner
test_results.xml
*.test

# AutoSAR configuration backups
*.arxml.bak
*.cfg.bak
# Seat control demo build/test dirs
examples/seat_control/build/
examples/seat_control/build_tests/
examples/seat_control/**/Testing/

# yuleOSH pipeline generated artifacts
.yuleosh/knowledge_graph.db
.yuleosh/store.db
.yuleosh/audit-evidence-*.zip
.yuleosh/audit/
.osh/store.db
.osh/evidence/compliance-pack.zip
.osh/ci/layer*.json
.coverage
coverage.json
__pycache__/
*.pyc
# DCM memory dump files
src/bsw/services/dcm/legacy/*.dump
build*/
.build/
*.elf
coverage.info
*.db
*.info
tools/deepen_*.py
tools/deepen_*.py

# Cppcheck dump files (分析临时文件)
*.dump
*.ctu-info

# dSYM debug info
dSYM/
*.dSYM

# Coverage run artifacts
coverage_run/bin/
# Coverage report output
# NVM configurator generated output
tools/nvm_configurator/output/
coverage_report_focused/
# Embedded git repos
third_party/lwip
NvM_EccHandler.c.bak2
src/bsw/boot/test/test_boot_integration

# Runtime session data (not source)
.osh/sessions/

# Hand-written make shim for yuleOSH L2 cross-compile gate (not CMake-generated)
!Makefile

# Large MISRA raw artifacts (full scan output, regenerated per CI run)
.yuleosh/reports/misra-report.json
.yuleosh/reports/misra-raw-output.txt
.yuleosh/reports/misra-report.xlsx

# Oversized MISRA artifacts (>200KB remote blob limit, kept locally)
.yuleosh/reports/misra-traceability.csv
.yuleosh/reports/traceability-report.json
.yuleosh/fix-tasks/misra-misra-c2023-2.5.md
.yuleosh/fix-tasks/misra-misra-c2023-15.5.md
