#=============================================================================
# MISRA C:2012 Configuration for ETH-DDS Integration Project
#=============================================================================
# Project: ETH-DDS Integration (AutoSAR Classic Platform)
# Module: COM (Communication Module)
# Standard: MISRA C:2012 Amendment 2
# Version: 1.0
# Date: 2026-04-29
#=============================================================================

[general]
# Standard to check against
standard = c11

# Platform target
platform = unix64

# Language
language = c

# Check level (normal, exhaustive)
check-level = exhaustive

# Maximum configurations to check (for #ifdef analysis)
max-configs = 10

# Force checking all configurations
force = true

[compliance]
# Compliance level: required, advisory, or all
level = all

# Required rules - must pass (deviation permit required)
required-categories = mandatory, required

# Advisory rules - should pass (deviation recommended)
advisory-categories = advisory

[rules]
# Explicitly enabled MISRA C:2012 rules
enable = 
    misra-c2012-1.1,  # C code shall conform to ISO/IEC 9899:2011
    misra-c2012-1.3,  # No undefined or critical unspecified behavior
    misra-c2012-2.1,  # No unreachable code
    misra-c2012-2.2,  # No dead code
    misra-c2012-3.1,  # Character sequences /* and // shall not be used within comments
    misra-c2012-5.1,  # External identifiers shall be distinct
    misra-c2012-5.9,  # Identifiers with internal linkage should be unique (advisory)
    misra-c2012-8.2,  # Function types shall be in prototype form with named parameters
    misra-c2012-8.4,  # Compatible declaration visible for external linkage
    misra-c2012-8.6,  # Single external definition
    misra-c2012-8.8,  # Static for internal linkage
    misra-c2012-8.13, # Pointer should point to const-qualified type (advisory)
    misra-c2012-9.1,  # No use before initialization
    misra-c2012-10.1, # Operands of appropriate essential type
    misra-c2012-10.3, # No assignment to narrower essential type
    misra-c2012-10.4, # Same essential type category in operations
    misra-c2012-11.1, # No conversion between function pointer and other types
    misra-c2012-11.3, # No cast between different object pointer types
    misra-c2012-11.6, # No cast between pointer to void and arithmetic type
    misra-c2012-11.8, # Cast shall not remove const/volatile qualification
    misra-c2012-12.1, # Explicit operator precedence (advisory)
    misra-c2012-12.2, # Shift range check
    misra-c2012-13.1, # No persistent side effects in initializers
    misra-c2012-13.2, # Consistent expression evaluation
    misra-c2012-13.5, # No side effects in right operand of && or ||
    misra-c2012-14.4, # Boolean controlling expressions
    misra-c2012-15.5, # Single point of exit (advisory)
    misra-c2012-15.6, # Compound statement for loops and selection
    misra-c2012-15.7, # Else clause for if-else-if
    misra-c2012-16.1, # Well-formed switch statements
    misra-c2012-16.3, # Unconditional break in switch clause
    misra-c2012-16.4, # Default label in switch
    misra-c2012-17.2, # No recursion
    misra-c2012-17.4, # Return statement in non-void function
    misra-c2012-17.7, # Use of non-void return value
    misra-c2012-17.8, # Function parameter should not be modified (advisory)
    misra-c2012-18.1, # Pointer arithmetic within array bounds
    misra-c2012-18.3, # Relational operators on same object pointers
    misra-c2012-18.6, # No address of automatic storage to persistent object
    misra-c2012-20.7, # Macro parameter parentheses
    misra-c2012-21.3, # No standard library memory management
    misra-c2012-21.6  # No standard library input/output

[suppressions]
# Global suppressions (use with caution)
suppress = 
    missingIncludeSystem,  # Standard library headers not available
    unmatchedSuppression,  # Don't warn about unused suppressions
    unusedFunction         # Functions may be called from other modules

# Suppressions file
suppressions-list = tools/misra/cppcheck_suppressions.xml

[include]
# Include directories
paths = 
    include
    include/autosar/classic/com
    include/autosar/standard
    src/bsw
    src/asw
    src/platform
    src/rte

[exclude]
# Excluded files/directories
paths = 
    tests/
    examples/
    generated/
    build/
    build_*/

[output]
# Output format: text, xml, html
format = xml

# XML version
xml-version = 2

# Show timing information
showtime = true

# Template for message format
template = "[{severity}][{id}] {file}:{line} {message}"

[addon]
# MISRA addon configuration
misra-c2012 = true

# Path to MISRA rules file
misra-rules-file = tools/misra/misra_rules.json

#=============================================================================
# Module-Specific Configuration (COM Module)
#=============================================================================

[module.com]
# COM module source files
source-files = 
    src/autosar/classic/com/Com.c
    src/autosar/classic/com/Com_Main.c
    src/autosar/classic/com/Com_Transmit.c
    src/autosar/classic/com/Com_Confirmation.c
    src/autosar/classic/com/Com_Signal.c
    src/autosar/classic/com/Com_TxMode.c
    src/autosar/classic/com/Com_DeadlineMon.c
    src/autosar/classic/com/Com_ErrorHandling.c

# COM module header files
header-files = 
    include/autosar/classic/com/Com.h
    include/autosar/classic/com/Com_Cfg.h
    include/autosar/classic/com/Com_Types.h
    include/autosar/classic/com/Com_Confirmation.h
    src/autosar/classic/com/Com_Private.h
    src/autosar/classic/com/Com_Transmit.h
    src/autosar/classic/com/Com_TxMode.h
    src/autosar/classic/com/Com_DeadlineMon.h
    src/autosar/classic/com/Com_ErrorHandling.h

# Module-specific suppressions
module-suppressions = 
    # Rule 15.5: Single exit point - allowed in error handlers
    misra-c2012-15.5:Com_ErrorHandling.c,
    # Rule 15.5: Single exit point - allowed in state machines
    misra-c2012-15.5:Com_TxMode.c,
    # Rule 17.7: Return value used - allowed for void cast pattern
    misra-c2012-17.7:Com*.c:memcpy

#=============================================================================
# Quality Gates
#=============================================================================

[quality-gate]
# Required rules must have zero violations
required-max = 0

# Advisory rules - warning threshold
advisory-max = 10

# Style issues - warning threshold
style-max = 20

# Maximum acceptable violations per rule
max-violations-per-rule = 5
