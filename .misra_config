#=============================================================================
# MISRA C:2023 Configuration for ETH-DDS Integration Project
#=============================================================================
# Project: ETH-DDS Integration (AutoSAR Classic Platform)
# Module: COM (Communication Module)
# Standard: MISRA C:2023
# Version: 2.0
# Date: 2026-07-28
# Migration: MISRA C:2012 → MISRA C:2023
# Change Notes:
#   - All rule prefixes updated from misra-c2012 to misra-c2023
#   - Added new C:2023 rules: 1.4 (emergent features), 8.14 (restrict pointer),
#     9.5 (designated initializer array size), 22.1 (dynamic heap memory),
#     dir-4.13 (static analysis confidence), dir-4.14 (external value validation)
#   - Rule 5.6 removed in C:2023 (merged with Rule 5.8); deviated projects ref in ci-config
#   - Several rules modified: 1.1, 2.2, 10.1, 10.3, 10.4, 11.3, 17.2, 18.4, 18.5, 21.12, 22.1, 8.13
#=============================================================================

[general]
# Standard to check against
standard = c11

# Platform target
platform = unix64

# Language
language = c

# Check level (normal, exhaustive)
check-level = exhaustive

# Maximum configurations to check (for #ifdef analysis)
max-configs = 10

# Force checking all configurations
force = true

[compliance]
# Compliance level: required, advisory, or all
level = all

# Required rules - must pass (deviation permit required)
required-categories = mandatory, required

# Advisory rules - should pass (deviation recommended)
advisory-categories = advisory

[rules]
# Explicitly enabled MISRA C:2023 rules
enable = 
    misra-c2023-1.1,  # C code shall conform to ISO/IEC 9899:2011 (modified)
    misra-c2023-1.3,  # No undefined or critical unspecified behavior (unchanged)
    misra-c2023-1.4,  # Emergent language features shall not be used (NEW)
    misra-c2023-2.1,  # No unreachable code (unchanged)
    misra-c2023-2.2,  # No dead code (modified — relaxed for debug macros)
    misra-c2023-3.1,  # Character sequences /* and // shall not be used within comments (unchanged)
    misra-c2023-5.1,  # External identifiers shall be distinct (unchanged)
    misra-c2023-5.9,  # Identifiers with internal linkage should be unique (unchanged)
    misra-c2023-8.2,  # Function types shall be in prototype form with named parameters (unchanged)
    misra-c2023-8.4,  # Compatible declaration visible for external linkage (unchanged)
    misra-c2023-8.6,  # Single external definition (unchanged)
    misra-c2023-8.8,  # Static for internal linkage (unchanged)
    misra-c2023-8.13, # Pointer should point to const-qualified type (modified — relaxed for embedded callbacks)
    misra-c2023-9.1,  # No use before initialization (unchanged)
    misra-c2023-10.1, # Operands of appropriate essential type (modified — clearer exception paths)
    misra-c2023-10.3, # No assignment to narrower essential type (modified — adjusted narrowing logic)
    misra-c2023-10.4, # Same essential type category in operations (modified — adjusted mismatched checks)
    misra-c2023-11.1, # No conversion between function pointer and other types (unchanged)
    misra-c2023-11.3, # No cast between different object pointer types (modified — stricter)
    misra-c2023-11.6, # No cast between pointer to void and arithmetic type (unchanged)
    misra-c2023-11.8, # Cast shall not remove const/volatile qualification (unchanged)
    misra-c2023-12.1, # Explicit operator precedence (unchanged)
    misra-c2023-12.2, # Shift range check (unchanged)
    misra-c2023-13.1, # No persistent side effects in initializers (unchanged)
    misra-c2023-13.2, # Consistent expression evaluation (unchanged)
    misra-c2023-13.5, # No side effects in right operand of && or || (unchanged)
    misra-c2023-14.4, # Boolean controlling expressions (unchanged)
    misra-c2023-15.5, # Single point of exit (unchanged)
    misra-c2023-15.6, # Compound statement for loops and selection (unchanged)
    misra-c2023-15.7, # Else clause for if-else-if (unchanged)
    misra-c2023-16.1, # Well-formed switch statements (unchanged)
    misra-c2023-16.3, # Unconditional break in switch clause (unchanged)
    misra-c2023-16.4, # Default label in switch (unchanged)
    misra-c2023-17.2, # No recursion (modified — tail-recursion exception)
    misra-c2023-17.4, # Return statement in non-void function (unchanged)
    misra-c2023-17.7, # Use of non-void return value (unchanged)
    misra-c2023-17.8, # Function parameter should not be modified (unchanged)
    misra-c2023-18.1, # Pointer arithmetic within array bounds (unchanged)
    misra-c2023-18.3, # Relational operators on same object pointers (unchanged)
    misra-c2023-18.6, # No address of automatic storage to persistent object (unchanged)
    misra-c2023-20.7, # Macro parameter parentheses (unchanged)
    misra-c2023-21.3, # No standard library memory management (unchanged)
    misra-c2023-21.6  # No standard library input/output (unchanged)

[suppressions]
# Global suppressions (use with caution)
suppress = 
    missingIncludeSystem,  # Standard library headers not available
    unmatchedSuppression,  # Don't warn about unused suppressions
    unusedFunction         # Functions may be called from other modules

# Suppressions file
suppressions-list = tools/misra/cppcheck_suppressions.xml

[include]
# Include directories — dynamically discovered by yuleOSH's _detect_include_paths()
# which walks src/, include/, tests/ and third_party/ scanning for **/include/ dirs.
# This is the single source of truth.  Do NOT hardcode paths here;
# add new modules to the source tree and they'll be picked up automatically.
paths =
    .

[exclude]
# Excluded files/directories — sync with ci-config.yaml misra.exclude_paths
paths = 
    tests/
    third_party/
    examples/
    generated/
    build/
    build_*/
    Drivers/
    Middlewares/

[output]
# Output format: text, xml, html
format = xml

# XML version
xml-version = 2

# Show timing information
showtime = true

# Template for message format
template = "[{severity}][{id}] {file}:{line} {message}"

[addon]
# MISRA addon configuration
misra-c2023 = true

# Path to MISRA rules file
misra-rules-file = tools/misra/misra_rules.json

#=============================================================================
# Module-Specific Configuration (COM Module)
#=============================================================================

[module.com]
# COM module source files
source-files = 
    src/bsw/classic/com/Com.c
    src/bsw/classic/com/Com_Main.c
    src/bsw/classic/com/Com_Transmit.c
    src/bsw/classic/com/Com_Confirmation.c
    src/bsw/classic/com/Com_Signal.c
    src/bsw/classic/com/Com_TxMode.c
    src/bsw/classic/com/Com_DeadlineMon.c
    src/bsw/classic/com/Com_ErrorHandling.c

# COM module header files
header-files = 
    include/autosar/classic/com/Com.h
    include/autosar/classic/com/Com_Cfg.h
    include/autosar/classic/com/Com_Types.h
    include/autosar/classic/com/Com_Confirmation.h
    src/bsw/classic/com/Com_Private.h
    src/bsw/classic/com/Com_Transmit.h
    src/bsw/classic/com/Com_TxMode.h
    src/bsw/classic/com/Com_DeadlineMon.h
    src/bsw/classic/com/Com_ErrorHandling.h

# Module-specific suppressions
module-suppressions = 
    # Rule 15.5: Single exit point - allowed in error handlers
    misra-c2023-15.5:Com_ErrorHandling.c,
    # Rule 15.5: Single exit point - allowed in state machines
    misra-c2023-15.5:Com_TxMode.c,
    # Rule 17.7: Return value used - allowed for void cast pattern
    misra-c2023-17.7:Com*.c:memcpy

#=============================================================================
# Quality Gates
#=============================================================================

[quality-gate]
# Required rules must have zero violations
required-max = 0

# Advisory rules - warning threshold
advisory-max = 10

# Style issues - warning threshold
style-max = 20

# Maximum acceptable violations per rule
max-violations-per-rule = 5
