          "type": "integer",
          "minimum": 0
        },
        "sequences": {
          "type": "integer",
          "minimum": 0
        },
        "hw_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gpt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
