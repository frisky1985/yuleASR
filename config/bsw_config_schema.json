    "$schema": {
      "type": "string",
      "description": "Optional meta-schema reference"
    },
    "version": {
      "type": "string",
      "description": "Config file semantic version",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "description": "Project level metadata",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor_id": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "modules": {
