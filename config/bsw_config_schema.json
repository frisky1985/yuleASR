      "type": "object",
      "description": "RTE generator invocation settings consumed by generate_bsw_config.py",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "arxml": {
          "type": "string",
          "description": "ARXML input path (relative to repo root)"
        },
        "output_subdir": {
          "type": "string"
        },
        "swc_filter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rte_h": {
              "type": "boolean"
            },
            "rte_c": {
              "type": "boolean"
            },
            "rte_type_h": {
              "type": "boolean"
            }
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "timing_event_prefix": {
              "type": "string"
            },
            "init_event_prefix": {
              "type": "string"
            }
          }
        }
      }
