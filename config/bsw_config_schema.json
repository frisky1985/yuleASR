        "modes": {
          "type": "integer",
          "minimum": 0
        },
        "reset_reasons": {
          "type": "integer",
          "minimum": 0
        },
        "core_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Configuration for core count"
        }
      }
    },
    "can": {
      "type": "object",
      "additionalProperties": true,
