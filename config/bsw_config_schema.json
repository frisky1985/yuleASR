        "hoh": {
          "type": "integer",
          "minimum": 0
        },
        "hw_objects": {
          "type": "integer",
          "minimum": 0
        },
        "baudrate": {
          "type": "integer",
          "minimum": 0
        },
        "supported_baudrates": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pins": {
          "type": "integer",
          "minimum": 0
        },
        "ports": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "spi": {
