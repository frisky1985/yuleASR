  "definitions": {
    "uint": {
      "type": "integer",
      "minimum": 0
    },
    "bool": {
      "type": "boolean"
    },
    "namedEntry": {
      "type": "object",
      "required": [
        "name",
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "moduleBase": {
      "type": "object",
      "required": [
        "name",
        "enabled"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        },
        "general": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "stdGeneral": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dev_error_detect": {
          "type": "boolean"
        },
        "version_info_api": {
          "type": "boolean"
        }
      }
    },
    "mcu": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
