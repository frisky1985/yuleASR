{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuletech.github.io/yuleASR/config/bsw_config_schema.json",
  "title": "yuleASR BSW unified configuration",
  "description": "Schema for config/bsw_config.json \u2014 the single configuration source rendered by Jinja2 templates (config/templates/*.h.j2) into BSW/RTE pre-compile configuration headers.",
  "type": "object",
  "required": [
    "version",
    "modules"
  ],
  "additionalProperties": true,
