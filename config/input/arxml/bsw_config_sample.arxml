        </ECUC-BOOLEAN-PARAM-VALUE>
        <ECUC-NUMERICAL-PARAM-VALUE>
          <DEFINITION-REF DEST="ECUC-PARAM-DEF">/Mcu/McuClockSettingConfig/McuCoreCount</DEFINITION-REF>
          <VALUE>4</VALUE>
        </ECUC-NUMERICAL-PARAM-VALUE>
        <ECUC-NUMERICAL-PARAM-VALUE>
          <DEFINITION-REF DEST="ECUC-PARAM-DEF">/Mcu/McuClockSettingConfig/McuSystemFrequencyHz</DEFINITION-REF>
          <VALUE>800000000</VALUE>
        </ECUC-NUMERICAL-PARAM-VALUE>
        <ECUC-NUMERICAL-PARAM-VALUE>
          <DEFINITION-REF DEST="ECUC-PARAM-DEF">/Mcu/McuClockSettingConfig/McuBusFrequencyHz</DEFINITION-REF>
          <VALUE>200000000</VALUE>
        </ECUC-NUMERICAL-PARAM-VALUE>
