        </ECUC-NUMERICAL-PARAM-VALUE>
        <ECUC-NUMERICAL-PARAM-VALUE>
          <DEFINITION-REF DEST="ECUC-PARAM-DEF">/Can/CanConfigSet/CanBaudrate</DEFINITION-REF>
