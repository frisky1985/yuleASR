<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 autosar_4-0-3.xsd">
  <ADMIN-DATA>
    <LANGUAGE>EN</LANGUAGE>
    <USED-LANGUAGES>
      <L-10>L-EN</L-10>
    </USED-LANGUAGES>
  </ADMIN-DATA>

  <ECUC-VALUES>
    <!-- Mcu Module Configuration -->
    <ECUC-VALUE>
      <SHORT-NAME>Mcu</SHORT-NAME>
      <CONTAINER>
        <SHORT-NAME>Mcu</SHORT-NAME>
        <ECUC-BOOLEAN-PARAM-VALUE>
          <DEFINITION-REF DEST="ECUC-PARAM-DEF">/Mcu/McuGeneral/McuDevErrorDetect</DEFINITION-REF>
          <VALUE>TRUE</VALUE>
        </ECUC-BOOLEAN-PARAM-VALUE>
        <ECUC-BOOLEAN-PARAM-VALUE>
          <DEFINITION-REF DEST="ECUC-PARAM-DEF">/Mcu/McuGeneral/McuVersionInfoApi</DEFINITION-REF>
