<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutoSAR 最小配置模板
  用途: 快速创建新的ARXML配置文件
  版本: AUTOSAR R4.0
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AR-PACKAGES>
    <!-- 项目包 -->
    <AR-PACKAGE UUID="package-your-project">
      <SHORT-NAME>YourProjectName</SHORT-NAME>
      <ELEMENTS>
        
        <!-- ========== ECU配置 ========== -->
        <ECU-CONFIGURATION>
          <SHORT-NAME>EcuConfig</SHORT-NAME>
          <ECU-NAME>YourECUName</ECU-NAME>
          <PROCESSOR>ARM_CORTEX_M4</PROCESSOR>
          <CLOCK>
            <CORE-CLOCK>80000000</CORE-CLOCK>
          </CLOCK>
          <MEMORY>
            <FLASH-SIZE>512</FLASH-SIZE>
            <RAM-SIZE>128</RAM-SIZE>
          </MEMORY>
        </ECU-CONFIGURATION>

        <!-- ========== 软件组件 ========== -->
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>YourSWC</SHORT-NAME>
          <PORTS>
            <!-- 发送端口 -->
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>YourPPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/YourProjectName/YourInterface</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <!-- 接收端口 -->
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>YourRPort</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/YourProjectName/YourInterface</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>

        <!-- ========== 端口接口 ========== -->
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>YourInterface</SHORT-NAME>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>YourDataElement</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/YourProjectName/Uint8Type</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>

        <!-- ========== 数据类型 ========== -->
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Uint8Type</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/YourProjectName/Uint8BaseType</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>

        <SW-BASE-TYPE>
          <SHORT-NAME>Uint8BaseType</SHORT-NAME>
          <BASE-TYPE-DEFINITION>
            <SW-DATA-DEF-PROPS>
              <SW-DATA-DEF-PROPS-VARIANTS>
                <SW-DATA-DEF-PROPS-CONDITIONAL>
                  <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                </SW-DATA-DEF-PROPS-CONDITIONAL>
              </SW-DATA-DEF-PROPS-VARIANTS>
            </SW-DATA-DEF-PROPS>
          </BASE-TYPE-DEFINITION>
        </SW-BASE-TYPE>

      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
