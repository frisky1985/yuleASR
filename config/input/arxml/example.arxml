<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AR-PACKAGES>
    <!-- 项目包 -->
    <AR-PACKAGE UUID="package-example-project">
      <SHORT-NAME>ExampleProject</SHORT-NAME>
      <ELEMENTS>
        
        <!-- ========== ECU配置 ========== -->
        <ECU-CONFIGURATION>
          <SHORT-NAME>EcuConfig</SHORT-NAME>
          <ECU-NAME>ExampleECU</ECU-NAME>
          <PROCESSOR>ARM_CORTEX_M4</PROCESSOR>
          <CLOCK>
            <CORE-CLOCK>80000000</CORE-CLOCK>
            <BUS-CLOCK>40000000</BUS-CLOCK>
          </CLOCK>
          <MEMORY>
            <FLASH-SIZE>512</FLASH-SIZE>
            <RAM-SIZE>128</RAM-SIZE>
          </MEMORY>
          <MODULE-CONFIGURATIONS>
            <MODULE-CONFIG REF="/ExampleProject/OsConfig"/>
            <MODULE-CONFIG REF="/ExampleProject/ComConfig"/>
            <MODULE-CONFIG REF="/ExampleProject/NvMConfig"/>
          </MODULE-CONFIGURATIONS>
        </ECU-CONFIGURATION>

        <!-- ========== 软件组件: SensorSWC ========== -->
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SensorSWC</SHORT-NAME>
          <PORTS>
            <!-- 发送端口: 传感器数据 -->
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>SensorDataPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/SensorDataInterface</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <!-- 接收端口: 校准参数 -->
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>CalibrationPort</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/CalibrationInterface</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>SensorBehavior</SHORT-NAME>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ReadSensorRunnable</SHORT-NAME>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <MINIMUM-START-INTERVAL>0.01</MINIMUM-START-INTERVAL>
                  <DATA-SEND-POINTS>
                    <DATA-SEND-POINT>
                      <SHORT-NAME>SendSensorData</SHORT-NAME>
                      <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/ExampleProject/SensorSWC/SensorDataPort</PORT-PROTOTYPE-REF>
                    </DATA-SEND-POINT>
                  </DATA-SEND-POINTS>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>

        <!-- ========== 软件组件: ControllerSWC ========== -->
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>ControllerSWC</SHORT-NAME>
          <PORTS>
            <!-- 接收端口: 传感器数据 -->
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>SensorInputPort</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/SensorDataInterface</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <!-- 发送端口: 控制指令 -->
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>ControlOutputPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/ControlCommandInterface</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <!-- 发送端口: 校准参数 -->
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>CalibrationOutputPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/CalibrationInterface</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>ControllerBehavior</SHORT-NAME>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ProcessControlRunnable</SHORT-NAME>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <MINIMUM-START-INTERVAL>0.005</MINIMUM-START-INTERVAL>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <DATA-RECEIVE-POINT-BY-ARGUMENT>
                      <SHORT-NAME>ReceiveSensorData</SHORT-NAME>
                      <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/ExampleProject/ControllerSWC/SensorInputPort</PORT-PROTOTYPE-REF>
                    </DATA-RECEIVE-POINT-BY-ARGUMENT>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>

        <!-- ========== 软件组件: ActuatorSWC ========== -->
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>ActuatorSWC</SHORT-NAME>
          <PORTS>
            <!-- 接收端口: 控制指令 -->
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>CommandInputPort</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/ControlCommandInterface</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <!-- 发送端口: 执行器状态 -->
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>ActuatorStatusPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleProject/ActuatorStatusInterface</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>ActuatorBehavior</SHORT-NAME>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ExecuteCommandRunnable</SHORT-NAME>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <MINIMUM-START-INTERVAL>0.01</MINIMUM-START-INTERVAL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>

        <!-- ========== 端口接口定义 ========== -->
        
        <!-- 传感器数据接口 -->
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>SensorDataInterface</SHORT-NAME>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>SensorValue</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint16Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>SensorStatus</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint8Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>

        <!-- 控制指令接口 -->
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>ControlCommandInterface</SHORT-NAME>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>CommandId</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint8Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>CommandValue</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint16Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>

        <!-- 校准参数接口 -->
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>CalibrationInterface</SHORT-NAME>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>Gain</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint16Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>1000</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>Offset</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Sint16Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>

        <!-- 执行器状态接口 -->
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>ActuatorStatusInterface</SHORT-NAME>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>ActuatorPosition</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint16Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>ErrorCode</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/ExampleProject/Uint8Type</TYPE-TREF>
              <INIT-VALUE>
                <NUMERICAL-VALUE-SPECIFICATION>
                  <VALUE>0</VALUE>
                </NUMERICAL-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>

        <!-- ========== 数据类型定义 ========== -->
        
        <!-- uint8 类型 -->
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Uint8Type</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/ExampleProject/Uint8BaseType</BASE-TYPE-REF>
                <DATA-LENGTH>8</DATA-LENGTH>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>

        <!-- uint16 类型 -->
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Uint16Type</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/ExampleProject/Uint16BaseType</BASE-TYPE-REF>
                <DATA-LENGTH>16</DATA-LENGTH>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>

        <!-- sint16 类型 -->
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Sint16Type</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/ExampleProject/Sint16BaseType</BASE-TYPE-REF>
                <DATA-LENGTH>16</DATA-LENGTH>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>

        <!-- 基础类型: uint8 -->
        <SW-BASE-TYPE>
          <SHORT-NAME>Uint8BaseType</SHORT-NAME>
          <BASE-TYPE-DEFINITION>
            <SW-DATA-DEF-PROPS>
              <SW-DATA-DEF-PROPS-VARIANTS>
                <SW-DATA-DEF-PROPS-CONDITIONAL>
                  <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                  <MEM-ALIGNMENT>8</MEM-ALIGNMENT>
                  <BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</BYTE-ORDER>
                </SW-DATA-DEF-PROPS-CONDITIONAL>
              </SW-DATA-DEF-PROPS-VARIANTS>
            </SW-DATA-DEF-PROPS>
          </BASE-TYPE-DEFINITION>
        </SW-BASE-TYPE>

        <!-- 基础类型: uint16 -->
        <SW-BASE-TYPE>
          <SHORT-NAME>Uint16BaseType</SHORT-NAME>
          <BASE-TYPE-DEFINITION>
            <SW-DATA-DEF-PROPS>
              <SW-DATA-DEF-PROPS-VARIANTS>
                <SW-DATA-DEF-PROPS-CONDITIONAL>
                  <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                  <MEM-ALIGNMENT>16</MEM-ALIGNMENT>
                  <BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</BYTE-ORDER>
                </SW-DATA-DEF-PROPS-CONDITIONAL>
              </SW-DATA-DEF-PROPS-VARIANTS>
            </SW-DATA-DEF-PROPS>
          </BASE-TYPE-DEFINITION>
        </SW-BASE-TYPE>

        <!-- 基础类型: sint16 -->
        <SW-BASE-TYPE>
          <SHORT-NAME>Sint16BaseType</SHORT-NAME>
          <BASE-TYPE-DEFINITION>
            <SW-DATA-DEF-PROPS>
              <SW-DATA-DEF-PROPS-VARIANTS>
                <SW-DATA-DEF-PROPS-CONDITIONAL>
                  <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>2C</BASE-TYPE-ENCODING>
                  <MEM-ALIGNMENT>16</MEM-ALIGNMENT>
                  <BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</BYTE-ORDER>
                </SW-DATA-DEF-PROPS-CONDITIONAL>
              </SW-DATA-DEF-PROPS-VARIANTS>
            </SW-DATA-DEF-PROPS>
          </BASE-TYPE-DEFINITION>
        </SW-BASE-TYPE>

        <!-- ========== 模块配置 (示例) ========== -->
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>OsConfig</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Os</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>OsTask</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsTask</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/Os/OsTask/OsTaskName</DEFINITION-REF>
                  <VALUE>SensorTask</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR/EcucDefs/Os/OsTask/OsTaskPriority</DEFINITION-REF>
                  <VALUE>5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>

        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>ComConfig</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Com</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ComGeneral</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComGeneral</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR/EcucDefs/Com/ComGeneral/ComVersionInfoApi</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>

        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>NvMConfig</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/NvM</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>NvMCommon</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/NvM/NvMCommon</DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>

      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
