{
    "name": "VehicleDDS",
    "version": "1.0.0",
    "description": "车辆DDS配置",
    "default_qos": {
        "reliability": {
            "kind": "RELIABLE",
            "max_blocking_time_sec": 0,
            "max_blocking_time_nsec": 100000000
        },
        "durability": {
            "kind": "TRANSIENT_LOCAL"
        },
        "deadline": {
            "period_sec": 0,
            "period_nsec": 500000000
        },
        "latency_budget": {
            "duration_sec": 0,
            "duration_nsec": 0
        },
        "liveliness": {
            "kind": "AUTOMATIC",
            "lease_duration_sec": 1,
            "lease_duration_nsec": 0
        },
        "history": {
            "kind": "KEEP_LAST",
            "depth": 10
        },
        "resource_limits": {
            "max_samples": 100,
            "max_instances": 10,
            "max_samples_per_instance": 10
        },
        "lifespan": {
            "duration_sec": 0,
            "duration_nsec": 0
        }
    },
    "domain_participants": [
        {
            "name": "VehicleDomain",
            "domain_id": 0,
            "description": "车辆域参与者",
            "qos": {
                "reliability": {
                    "kind": "RELIABLE"
                },
                "durability": {
                    "kind": "TRANSIENT_LOCAL"
                }
            },
            "topics": [
                {
                    "name": "VehicleSpeed",
                    "type_name": "Vehicle::SpeedData",
                    "description": "车速数据",
                    "qos": {
                        "reliability": {
                            "kind": "BEST_EFFORT"
                        },
                        "history": {
                            "kind": "KEEP_LAST",
                            "depth": 1
                        },
                        "deadline": {
                            "period_sec": 0,
                            "period_nsec": 100000000
                        }
                    }
                },
                {
                    "name": "EngineTemp",
                    "type_name": "Vehicle::Temperature",
                    "description": "发动机温度",
                    "qos": {
                        "reliability": {
                            "kind": "RELIABLE"
                        },
                        "durability": {
                            "kind": "TRANSIENT_LOCAL"
                        },
                        "history": {
                            "kind": "KEEP_LAST",
                            "depth": 5
                        }
                    }
                }
            ]
        }
    ]
}
