<?xml version="1.0" encoding="UTF-8"?>
<dds_config name="VehicleDDS" version="1.0.0" description="车辆DDS配置">

    <default_qos>
        <reliability kind="RELIABLE" max_blocking_time_sec="0" max_blocking_time_nsec="100000000"/>
        <durability kind="TRANSIENT_LOCAL"/>
        <deadline period_sec="0" period_nsec="500000000"/>
        <latency_budget duration_sec="0" duration_nsec="0"/>
        <liveliness kind="AUTOMATIC" lease_duration_sec="1" lease_duration_nsec="0"/>
        <history kind="KEEP_LAST" depth="10"/>
        <resource_limits max_samples="100" max_instances="10" max_samples_per_instance="10"/>
        <lifespan duration_sec="0" duration_nsec="0"/>
    </default_qos>

    <domain_participant name="VehicleDomain" domain_id="0" description="车辆域参与者">
        <qos>
            <reliability kind="RELIABLE"/>
            <durability kind="TRANSIENT_LOCAL"/>
        </qos>

        <topics>
            <topic name="VehicleSpeed" type_name="Vehicle::SpeedData" description="车速数据">
                <qos>
                    <reliability kind="BEST_EFFORT"/>
                    <history kind="KEEP_LAST" depth="1"/>
                    <deadline period_sec="0" period_nsec="100000000"/>
                </qos>
            </topic>

            <topic name="EngineTemp" type_name="Vehicle::Temperature" description="发动机温度">
                <qos>
                    <reliability kind="RELIABLE"/>
                    <durability kind="TRANSIENT_LOCAL"/>
                    <history kind="KEEP_LAST" depth="5"/>
                </qos>
            </topic>

            <topic name="DiagnosticData" type_name="Vehicle::Diagnostics" description="诊断数据">
                <qos>
                    <reliability kind="RELIABLE"/>
                    <history kind="KEEP_ALL"/>
                    <resource_limits max_samples="50" max_instances="5" max_samples_per_instance="10"/>
                </qos>
            </topic>
        </topics>
    </domain_participant>

    <domain_participant name="InfotainmentDomain" domain_id="1" description="信息娱乐域参与者">
        <topics>
            <topic name="MediaStatus" type_name="Infotainment::MediaInfo" description="媒体状态">
                <qos>
                    <reliability kind="BEST_EFFORT"/>
                    <history kind="KEEP_LAST" depth="3"/>
                </qos>
            </topic>
        </topics>
    </domain_participant>

</dds_config>
