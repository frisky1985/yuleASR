unusedFunction

# knownConditionTrueFalse: Socket API checks (udp.c, Eth_Irq.c, Dlt.c, J1939Tp.c,
# RamSafety.c) that cppcheck flags as always true/false due to limited data flow
# analysis. These are legitimate runtime checks (socket operations can fail,
# PHY interrupts are real).
knownConditionTrueFalse

# unusedStructMember: AUTOSAR configuration structs (CanSm, Dcm, Dem, UDP, micro-dds)
# have fields that are part of the AUTOSAR BSW API contract per R21-11 §7.3.
# Some are reserved for future use or required by AUTOSAR arxml schema.
unusedStructMember

# constParameterPointer: Crypto key/IO parameters (CryIf, NvM queue Head/Tail)
# are intentionally output parameters that get written through.
# cppcheck sees them as const-able because analysis is incomplete.
constParameterPointer

# constVariablePointer: J1939Tp channel ptr, LinSM channelState ptr, SomeIpSd entry.
# These are intentionally non-const because the struct pointer is cast between
# types in the AUTOSAR adapter layer.
constVariablePointer

# shadowVariable: XCP DAQ command handlers use 'response' as a local buffer name
# in every command handler for consistency with the XCP protocol naming.
# Each is a separate function scope with zero cross-interference.
# dem.c: remove the redundant extern declaration.
shadowVariable
shadowArgument

# unassignedVariable: EthSM state handler variables are init with = 0U
# as fallback; cppcheck's analysis flow doesn't track the if/else branches.
unassignedVariable



# ---------------------------------------------------------------------------
# Phase 2 Batch C — MISRA Required (Advisory) Suppressions
