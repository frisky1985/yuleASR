diff --git a/include/autosar/Boot_Handshake.h b/include/autosar/Boot_Handshake.h
index 24db3e3..48e8706 100644
--- a/include/autosar/Boot_Handshake.h
+++ b/include/autosar/Boot_Handshake.h
@@ -39,9 +39,13 @@ typedef uint32_t Boot_HandshakeType;
 #define BOOT_HANDSHAKE_MAGIC            0x48534842U   /* 'BHSH' = Boot HandShake */
 #define BOOT_HANDSHAKE_VERSION          0x00010000U   /* v1.0 */
 
-/** S32K312 SRAM_U 顶部保留 32 字节 (0x2007FFE0 - 0x2007FFFF) */
+/** S32K312 Safe RAM 顶部保留 32 字节 (0x2000FFE0 - 0x2000FFFF)
+ *  选位原则: 必须同时避开 ①栈区 (0x20060000-0x20080000, 向下增长)
+ *            ②所有 BSS 清零范围 (.bss 在 ram_general, __bss_start..__bss_end)
+ *            ③PBL ram_pbl (0x20000000-0x20000FFF, 仅 4KB)
+ *  0x2000FFE0 位于 ram_safe 顶部, 低于栈底且远超 PBL RAM, 满足全部约束。 */
 #ifndef BOOT_HANDSHAKE_ADDR
-#define BOOT_HANDSHAKE_ADDR             0x2007FFE0UL
+#define BOOT_HANDSHAKE_ADDR             0x2000FFE0UL
 #endif
 
 typedef struct {
diff --git a/src/platform/s32k312/linker/s32k312.ld b/src/platform/s32k312/linker/s32k312.ld
index 9f67a05..fba28ea 100644
--- a/src/platform/s32k312/linker/s32k312.ld
+++ b/src/platform/s32k312/linker/s32k312.ld
@@ -27,8 +27,13 @@ MEMORY
     flash_rsvd2   (rx): ORIGIN = 0x001F8000, LENGTH = 0x8000      /* 32KB - Reserved for NVM/EEPROM emulation */
 
     /* RAM - 512KB */
-    /* First 64KB: Safe RAM for critical data (ECC protected) */
-    ram_safe      (rwx): ORIGIN = 0x20000000, LENGTH = 0x10000    /* 64KB - Safe RAM (Lockstep, ECC) */
+    /* First 64KB: Safe RAM for critical data (ECC protected)
+     * 顶部 32B (0x2000FFE0-0x2000FFFF) 预留给 App<->Bootloader 握手块,
+     * 见 ram_handshake; 启动代码不清零该区域, 跨软复位保持。 */
+    ram_safe      (rwx): ORIGIN = 0x20000000, LENGTH = 0xFFE0     /* 64KB - 32B Safe RAM */
+
+    /* App<->Bootloader 握手块 (NOINIT, 跨复位保持) */
+    ram_handshake (rw):  ORIGIN = 0x2000FFE0, LENGTH = 0x20       /* 32B Boot HandShake */
     
     /* Next 384KB: General purpose RAM */
     ram_general   (rwx): ORIGIN = 0x20010000, LENGTH = 0x60000    /* 384KB - General RAM */
@@ -185,6 +190,19 @@ SECTIONS
         __safe_bss_end = ABSOLUTE(.);
     } > ram_safe
 
+    /* App<->Bootloader 握手块 — NOLOAD, 不加入任何清零表
+     * 启动代码 (__bss_start..__bss_end) 不清零此区域;
+     * App 在 EcuM_PerformReset 前写入, SBL 在 Boot_Loader_Main Phase 0 读取。 */
+    .boot_handshake (NOLOAD) :
+    {
+        . = ALIGN(4);
+        __boot_handshake_start = ABSOLUTE(.);
+        KEEP(*(.boot_handshake))
+        KEEP(*(.boot_handshake.*))
+        . = . + 0x20;   /* 强制保留 32 字节, 即使无输入段也占位 */
+        __boot_handshake_end = ABSOLUTE(.);
+    } > ram_handshake
+
     /* Initialized Data Section — LMA contiguous after .ram_safe_data LMA */
     .data : AT(__safe_data_load + SIZEOF(.ram_safe_data))
     {
